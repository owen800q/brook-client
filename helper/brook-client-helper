#!/bin/sh
# brook-client-helper — the privileged half of Brook Client.
#
# Installed root-owned at /Library/PrivilegedHelperTools/com.brookclient.helper and
# allowed (NOPASSWD, this exact path only) via /etc/sudoers.d/com.brookclient.
# Every argument is validated here; the GUI is not trusted.
#
#   up       --socks PORT --gateway IP --interface IF --server IP|local... [--net CIDR...]
#            [--link CIDR...] [--dns IP...] [--ipv6 block] --watch PID
#   proxy-on --interface IF --http PORT --socks PORT [--bypass CIDR...] --watch PID
#   down
#   status
#
# Exit codes: 0 ok, 1 runtime failure, 2 invalid arguments (nothing was changed).

set -u
set -f # no globbing: "*.local" etc. stay literal
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
umask 077

SELF=/Library/PrivilegedHelperTools/com.brookclient.helper
TUN2SOCKS=/Library/PrivilegedHelperTools/com.brookclient.tun2socks
STATE_DIR=/var/run/com.brookclient
LOG=/var/log/com.brookclient.log
TUN_ADDR=198.18.0.1
DRY=0

# Dry-run (tests): print commands instead of running them. Never honoured as root.
if [ "${BROOK_HELPER_DRYRUN:-}" = 1 ] && [ "$(id -u)" != 0 ]; then
	DRY=1
	STATE_DIR=${BROOK_HELPER_STATE_DIR:?BROOK_HELPER_STATE_DIR required in dry-run}
	LOG=$STATE_DIR/helper.log
	SELF=$0
fi
STATE=$STATE_DIR/state

usage() { echo "brook-client-helper: $*" >&2; exit 2; }
log() { echo "brook-client-helper: $*" >&2; }

run() {
	if [ $DRY = 1 ]; then echo "+ $*"; else "$@"; fi
}

# Like run, but silences the command's own output in real mode.
runq() {
	if [ $DRY = 1 ]; then echo "+ $*"; else "$@" >/dev/null 2>&1; fi
}

# ---------------------------------------------------------------- validation

is_ipv4() {
	case $1 in '' | *[!0-9.]* | .* | *. | *..*) return 1 ;; esac
	_ifs=$IFS; IFS=.; set -- $1; IFS=$_ifs
	[ $# -eq 4 ] || return 1
	for _o; do
		case $_o in 0 | [1-9] | [1-9][0-9] | 1[0-9][0-9] | 2[0-4][0-9] | 25[0-5]) ;; *) return 1 ;; esac
	done
}

is_cidr() {
	case $1 in */*) ;; *) return 1 ;; esac
	case ${1#*/} in [0-9] | [12][0-9] | 3[0-2]) ;; *) return 1 ;; esac
	is_ipv4 "${1%/*}"
}

# Route targets: valid and not 0.0.0.0.
is_route_ip() { is_ipv4 "$1" && [ "$1" != 0.0.0.0 ]; }

# Bypass ranges: nothing wider than /4 (224.0.0.0/4 multicast), so the tunnel can't be defeated.
is_bypass_cidr() {
	is_cidr "$1" || return 1
	case ${1#*/} in [0-3]) return 1 ;; esac
}

is_uint() { case $1 in '' | *[!0-9]* | 0*) return 1 ;; esac; [ ${#1} -le 10 ]; }
is_port() { is_uint "$1" && [ ${#1} -le 5 ] && [ "$1" -le 65535 ]; }
is_iface() { case $1 in '' | *[!a-z0-9]*) return 1 ;; esac; [ ${#1} -le 15 ]; }
is_tun() { case $1 in utun[0-9] | utun[0-9][0-9] | utun[0-9][0-9][0-9]) return 0 ;; esac; return 1; }

# Values taken from the system (service names, prior DNS/bypass lists) are re-checked when
# read back from the state dir.
is_service() { case $1 in '' | *[!A-Za-z0-9\ ./_\(\)-]*) return 1 ;; esac; }
is_bypass_entry() { case $1 in '' | *[!A-Za-z0-9.*/:_\<\>-]*) return 1 ;; esac; }
is_proxy_host() { case $1 in '' | -* | *[!A-Za-z0-9.:_-]*) return 1 ;; esac; [ ${#1} -le 253 ]; }
is_dns_entry() { [ "$1" = Empty ] && return 0; case $1 in '' | *[!0-9A-Fa-f:.]*) return 1 ;; esac; }

# Is PID still the process we started (guards against PID reuse before killing as root)?
is_ours() { # pid substring-of-command
	[ $DRY = 1 ] && return 0
	alive "$1" || return 1
	case $(ps -p "$1" -o command= 2>/dev/null) in *"$2"*) return 0 ;; esac
	return 1
}

# ---------------------------------------------------------------- system queries

service_for() {
	if [ $DRY = 1 ]; then echo "${BROOK_HELPER_SERVICE:-}"; return; fi
	networksetup -listnetworkserviceorder | awk -v dev="$1" '
		/^\([0-9*]+\) / { sub(/^\([0-9*]+\) /, ""); name = $0; next }
		index($0, "Device: " dev ")") { print name; exit }'
}

current_dns() {
	[ $DRY = 1 ] && { echo Empty; return; }
	_out=$(networksetup -getdnsservers "$1" 2>/dev/null)
	case $_out in *"aren't any"* | '') echo Empty ;; *) echo $_out ;; esac
}

current_bypass() {
	[ $DRY = 1 ] && { echo Empty; return; }
	_out=$(networksetup -getproxybypassdomains "$1" 2>/dev/null)
	case $_out in *"aren't any"* | '') echo Empty ;; *) echo $_out ;; esac
}

# Prints "<on|off> <host> <port>" for one proxy kind (web, secureweb, socksfirewall), so a
# company proxy configured in macOS is put back on disconnect instead of being switched off.
current_proxy() { # service kind
	if [ $DRY = 1 ]; then echo "${BROOK_HELPER_PREV_PROXY:-off - 0}"; return; fi
	networksetup -get"$2"proxy "$1" 2>/dev/null | awk '
		/^Enabled:/ { on = ($2 == "Yes") ? "on" : "off" }
		/^Server:/ { host = $2 }
		/^Port:/ { port = $2 }
		END { if (host == "") host = "-"; if (port == "") port = 0; print (on == "" ? "off" : on), host, port }'
}

restore_proxy() { # service kind
	_line=$(grep "^$2 " "$STATE_DIR/proxy_prev" 2>/dev/null)
	set -- "$1" "$2" $_line
	if [ "${4:-}" = on ] && is_proxy_host "${5:-}" && is_port "${6:-}"; then
		run networksetup -set"$2"proxy "$1" "$5" "$6"
	else
		run networksetup -set"$2"proxystate "$1" off
	fi
}

free_tun() {
	if [ $DRY = 1 ]; then echo "${BROOK_HELPER_TUN:-utun199}"; return; fi
	_n=100
	while [ $_n -lt 200 ]; do
		ifconfig "utun$_n" >/dev/null 2>&1 || { echo "utun$_n"; return; }
		_n=$((_n + 1))
	done
	return 1
}

alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }

# ---------------------------------------------------------------- state

record() { echo "$*" >>"$STATE"; }

state_get() { # first value of a single-valued record
	[ -f "$STATE" ] && awk -v k="$1" '$1 == k { print $2; exit }' "$STATE"
}

# ---------------------------------------------------------------- down

do_down() {
	[ -f "$STATE" ] || return 0
	_svc=""
	[ -f "$STATE_DIR/service" ] && _svc=$(cat "$STATE_DIR/service")
	is_service "$_svc" || _svc=""

	# 1. Stop sending traffic into the tunnel.
	while read -r _k _a _b _c; do
		[ "$_k" = tunroute ] && is_cidr "$_a" && is_tun "$_b" &&
			runq route -n delete -net "$_a" -interface "$_b"
		[ "$_k" = v6reject ] && runq route -n delete -inet6 -net 2000::/3 ::1 -reject
	done <"$STATE"

	# 2. Restore system DNS / proxy settings.
	if [ -n "$_svc" ] && [ -f "$STATE_DIR/dns_prev" ]; then
		_prev=$(cat "$STATE_DIR/dns_prev")
		_ok=1
		for _d in $_prev; do is_dns_entry "$_d" || _ok=0; done
		[ $_ok = 1 ] || _prev=Empty
		run networksetup -setdnsservers "$_svc" $_prev
		run dscacheutil -flushcache
		run killall -HUP mDNSResponder
	fi
	if [ -n "$_svc" ] && grep -q '^proxy$' "$STATE"; then
		for _kind in web secureweb socksfirewall; do restore_proxy "$_svc" "$_kind"; done
		if [ -f "$STATE_DIR/bypass_prev" ]; then
			_prev=$(cat "$STATE_DIR/bypass_prev")
			_ok=1
			for _d in $_prev; do is_bypass_entry "$_d" || _ok=0; done
			[ $_ok = 1 ] || _prev=Empty
			run networksetup -setproxybypassdomains "$_svc" $_prev
		fi
	fi

	# 3. Stop processes (but not the watchdog that is running us).
	_w=$(state_get watch)
	if is_uint "$_w" && [ "$_w" != "$PPID" ] && [ "$_w" != $$ ] && is_ours "$_w" com.brookclient.helper; then
		run kill "$_w" 2>/dev/null
	fi
	_t=$(state_get tun2socks)
	if is_uint "$_t" && is_ours "$_t" com.brookclient.tun2socks; then
		run kill "$_t"
		if [ $DRY = 0 ]; then
			_i=0
			while alive "$_t" && [ $_i -lt 30 ]; do sleep 0.1; _i=$((_i + 1)); done
			alive "$_t" && kill -9 "$_t"
		fi
	fi

	# 4. Remove the server and bypass routes.
	while read -r _k _a _b _c; do
		case $_k in
		host) is_ipv4 "$_a" && is_ipv4 "$_b" && runq route -n delete -host "$_a" "$_b" ;;
		net) is_cidr "$_a" && is_ipv4 "$_b" && runq route -n delete -net "$_a" "$_b" ;;
		link) is_cidr "$_a" && is_iface "$_b" && runq route -n delete -net "$_a" -interface "$_b" ;;
		esac
	done <"$STATE"

	rm -f "$STATE" "$STATE_DIR/service" "$STATE_DIR/dns_prev" "$STATE_DIR/bypass_prev" "$STATE_DIR/proxy_prev"
	return 0
}

# ---------------------------------------------------------------- watchdog

# Tear everything down when the GUI (or tun2socks) dies, so traffic is never left
# pointing at a dead proxy.
start_watch() { # app_pid [tun2socks_pid]
	if [ $DRY = 1 ]; then
		echo "+ watch $1"
		record watch 999998
		return
	fi
	(
		trap '' HUP
		while alive "$1" && { [ -z "${2:-}" ] || alive "$2"; }; do sleep 2; done
		"$SELF" down # a child, so down sees the watchdog as $PPID and doesn't kill it
	) </dev/null >>"$LOG" 2>&1 &
	record watch $!
}

# ---------------------------------------------------------------- up

do_up() {
	_socks="" _gw="" _if="" _watch="" _servers="" _local=0 _nets="" _links="" _dns="" _v6block=0
	while [ $# -gt 0 ]; do
		[ $# -ge 2 ] || usage "missing value for $1"
		case $1 in
		--socks) is_port "$2" || usage "bad port: $2"; _socks=$2 ;;
		--gateway) is_route_ip "$2" || usage "bad gateway: $2"; _gw=$2 ;;
		--interface) is_iface "$2" || usage "bad interface: $2"; _if=$2 ;;
		--server)
			# "local": brook reaches the internet via a proxy on this Mac, so no host route is needed.
			if [ "$2" = local ]; then _local=1; else is_route_ip "$2" || usage "bad server: $2"; _servers="$_servers $2"; fi ;;
		--net) is_bypass_cidr "$2" || usage "bad cidr: $2"; _nets="$_nets $2" ;;
		--link) is_bypass_cidr "$2" || usage "bad cidr: $2"; _links="$_links $2" ;;
		--dns) is_ipv4 "$2" || usage "bad dns: $2"; _dns="$_dns $2" ;;
		--ipv6) [ "$2" = block ] || usage "bad --ipv6: $2"; _v6block=1 ;;
		--watch) is_uint "$2" || usage "bad pid: $2"; _watch=$2 ;;
		*) usage "unknown option: $1" ;;
		esac
		shift 2
	done
	[ -n "$_socks" ] && [ -n "$_gw" ] && [ -n "$_if" ] && { [ -n "$_servers" ] || [ $_local = 1 ]; } && [ -n "$_watch" ] ||
		usage "up requires --socks --gateway --interface --server --watch"
	[ $DRY = 1 ] || [ -x "$TUN2SOCKS" ] || { log "missing $TUN2SOCKS"; exit 1; }

	do_down
	mkdir -p "$STATE_DIR"
	: >"$STATE"
	record mode tun

	_tun=$(free_tun) || { log "no free utun device"; exit 1; }
	record tun "$_tun"

	# Server + bypass routes go in before the catch-all, so LAN traffic never hits the tunnel.
	# Only routes we actually added are recorded, so down never removes a pre-existing one.
	for _s in $_servers; do
		runq route -n add -host "$_s" "$_gw" && record host "$_s" "$_gw"
	done
	for _n in $_nets; do
		runq route -n add -net "$_n" "$_gw" && record net "$_n" "$_gw"
	done
	for _n in $_links; do
		runq route -n add -net "$_n" -interface "$_if" && record link "$_n" "$_if"
	done

	if [ $DRY = 1 ]; then
		echo "+ $TUN2SOCKS --device $_tun --proxy socks5://127.0.0.1:$_socks --loglevel warn"
		_t2s=999999
	else
		"$TUN2SOCKS" --device "$_tun" --proxy "socks5://127.0.0.1:$_socks" --loglevel warn </dev/null >>"$LOG" 2>&1 &
		_t2s=$!
	fi
	record tun2socks "$_t2s"

	if [ $DRY = 0 ]; then
		_i=0
		until ifconfig "$_tun" >/dev/null 2>&1; do
			_i=$((_i + 1))
			if [ $_i -gt 50 ] || ! alive "$_t2s"; then log "tun2socks failed to create $_tun (see $LOG)"; do_down; exit 1; fi
			sleep 0.1
		done
	fi
	run ifconfig "$_tun" "$TUN_ADDR" "$TUN_ADDR" netmask 255.255.255.255 up

	if [ -n "$_dns" ]; then
		_svc=$(service_for "$_if")
		if is_service "$_svc"; then
			echo "$_svc" >"$STATE_DIR/service"
			current_dns "$_svc" >"$STATE_DIR/dns_prev"
			run networksetup -setdnsservers "$_svc" $_dns
			run dscacheutil -flushcache
			run killall -HUP mDNSResponder
		else
			log "no network service for $_if; leaving DNS unchanged"
		fi
	fi

	for _n in 0.0.0.0/1 128.0.0.0/1; do
		record tunroute "$_n" "$_tun"
		runq route -n add -net "$_n" -interface "$_tun" || { log "failed to add $_n"; do_down; exit 1; }
	done

	# Reject (fast ICMP unreachable, so apps fall back to IPv4) instead of leaking IPv6 outside
	# the IPv4-only tunnel. Link-local and ULA (fc00::/7) LAN IPv6 stay reachable.
	if [ $_v6block = 1 ]; then
		runq route -n add -inet6 -net 2000::/3 ::1 -reject && record v6reject
	fi

	start_watch "$_watch" "$_t2s"
	echo "tun $_tun"
}

# ---------------------------------------------------------------- proxy-on

do_proxy_on() {
	_if="" _http="" _socks="" _bypass="" _watch=""
	while [ $# -gt 0 ]; do
		[ $# -ge 2 ] || usage "missing value for $1"
		case $1 in
		--interface) is_iface "$2" || usage "bad interface: $2"; _if=$2 ;;
		--http) is_port "$2" || usage "bad port: $2"; _http=$2 ;;
		--socks) is_port "$2" || usage "bad port: $2"; _socks=$2 ;;
		--bypass) is_bypass_cidr "$2" || usage "bad cidr: $2"; _bypass="$_bypass $2" ;;
		--watch) is_uint "$2" || usage "bad pid: $2"; _watch=$2 ;;
		*) usage "unknown option: $1" ;;
		esac
		shift 2
	done
	[ -n "$_if" ] && [ -n "$_http" ] && [ -n "$_socks" ] && [ -n "$_watch" ] ||
		usage "proxy-on requires --interface --http --socks --watch"

	_svc=$(service_for "$_if")
	is_service "$_svc" || { log "no network service for $_if"; exit 1; }

	do_down
	mkdir -p "$STATE_DIR"
	: >"$STATE"
	record mode proxy
	echo "$_svc" >"$STATE_DIR/service"
	current_bypass "$_svc" >"$STATE_DIR/bypass_prev"
	for _kind in web secureweb socksfirewall; do echo "$_kind $(current_proxy "$_svc" "$_kind")"; done >"$STATE_DIR/proxy_prev"
	record proxy

	run networksetup -setwebproxy "$_svc" 127.0.0.1 "$_http"
	run networksetup -setsecurewebproxy "$_svc" 127.0.0.1 "$_http"
	run networksetup -setsocksfirewallproxy "$_svc" 127.0.0.1 "$_socks"
	run networksetup -setproxybypassdomains "$_svc" localhost 127.0.0.1 '*.local' $_bypass

	start_watch "$_watch"
	echo "proxy $_svc"
}

# ---------------------------------------------------------------- status

do_status() {
	_mode=$(state_get mode)
	case $_mode in
	tun) alive "$(state_get tun2socks)" && { echo "running tun $(state_get tun)"; return 0; } ;;
	proxy) alive "$(state_get watch)" && { echo "running proxy"; return 0; } ;;
	esac
	echo stopped
	return 3
}

# ---------------------------------------------------------------- main

[ $# -ge 1 ] || usage "missing command"
cmd=$1
shift
case $cmd in
up) do_up "$@" ;;
proxy-on) do_proxy_on "$@" ;;
down) [ $# -eq 0 ] || usage "down takes no arguments"; do_down ;;
status) do_status ;;
*) usage "unknown command: $cmd" ;;
esac
